{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "feat/**": false,
      "feature/**": false,
      "fix/**": false,
      "perf/**": false,
      "chore/**": false,
      "docs/**": false,
      "ci/**": false,
      "e2e/**": false,
      "dependabot/**": false,
      "ccr-*": false,
      "*-backlog": false
    }
  },
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/run-saved-searches",
      "schedule": "50 5 * * *"
    },
    {
      "path": "/api/cron/drain-events",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/discovery-campaigns",
      "schedule": "5 6 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/expire-licenses",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/check-whatsapp-health",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/send-compliance-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/expire-exports",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ops-alerts",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/post-recurring-entries",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/escalate-conversations",
      "schedule": "45 6 * * *"
    }
  ]
}
